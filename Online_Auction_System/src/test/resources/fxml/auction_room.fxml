<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionRoomController"
            stylesheets="@../css/style.css">

    <top>
        <HBox spacing="16.0" alignment="CENTER_LEFT" styleClass="room-header">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="← Quay lại" onAction="#onBack"/>
            <Label fx:id="itemNameLabel" styleClass="title" text="Tên vật phẩm"/>
            <Label fx:id="statusLabel" styleClass="badge" text="RUNNING"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="timerLabel" styleClass="timer" text="00:00:00"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="10.0" prefWidth="230.0" styleClass="side-panel">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Thông tin vật phẩm" styleClass="section-title"/>
            <Label fx:id="itemDetailsLabel" wrapText="true"/>
            <Label fx:id="startPriceLabel" text="Giá khởi điểm: -"/>
            <Label fx:id="minIncrementLabel"/>
            <Label fx:id="sellerLabel" text="Người bán: -"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10.0">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Giá hiện tại" styleClass="section-title"/>
            <Label fx:id="currentPriceLabel" styleClass="price" text="0 đ"/>
            <Label fx:id="leaderLabel" text="Chưa có người đặt giá"/>
            <Label fx:id="resultBanner" styleClass="result-banner" wrapText="true"
                   managed="false" visible="false" maxWidth="Infinity"/>
            <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS" animated="false"
                       legendVisible="false" title="Lịch sử giá">
                <xAxis>
                    <NumberAxis fx:id="xAxis" label="Lượt bid" forceZeroInRange="false"
                                tickUnit="1.0" minorTickVisible="false"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="yAxis" label="Giá (đ)" forceZeroInRange="false"/>
                </yAxis>
            </LineChart>
        </VBox>
    </center>

    <right>
        <VBox spacing="8.0" prefWidth="320.0">
            <padding><Insets top="16" right="16" bottom="16" left="0"/></padding>
            <Label text="Lịch sử đặt giá" styleClass="section-title"/>
            <TableView fx:id="bidTable" VBox.vgrow="ALWAYS"
                       columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                <columns>
                    <TableColumn fx:id="timeCol" text="Giờ" sortable="false"/>
                    <TableColumn fx:id="bidderCol" text="Người đặt" sortable="false"/>
                    <TableColumn fx:id="amountCol" text="Giá" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </right>

    <bottom>
        <VBox spacing="6.0" styleClass="bid-bar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <HBox spacing="12.0" alignment="CENTER_LEFT">
                <Label fx:id="balanceLabel" text="Số dư: 0 đ"/>
                <TextField fx:id="bidField" promptText="Nhập giá..." HBox.hgrow="ALWAYS"/>
                <Button fx:id="bidButton" text="ĐẶT GIÁ" onAction="#onPlaceBid"
                        styleClass="primary-button"/>
            </HBox>
            <Label fx:id="messageLabel" wrapText="true"/>
        </VBox>
    </bottom>
</BorderPane>
